{
  "$schema": "https://zoth.nullai.tech/schemas/netlify-ax.v2.4.json",
  "schema_version": "2.4.0",
  "generator": "Zoth Netlify AX & Serverless Edge Engine (v2.4.0)",
  "site": {
    "name": "Zoth Studio v2",
    "canonical_url": "https://zoth.nullai.tech",
    "publish_directory": "dist",
    "build_command": "npm run build",
    "functions_directory": "netlify/functions",
    "edge_functions_directory": "netlify/edge-functions",
    "node_version_target": "20",
    "node_bundler": "esbuild",
    "framework": "React 19 + Vite + MUI + Three.js + WebGPU"
  },
  "security_boundary": {
    "read_only_inspector": true,
    "reads_netlify_credentials": false,
    "reads_dot_env_files": false,
    "remote_deploy_mutations": false,
    "loopback_host_origin_guard": true
  },
  "build_health": {
    "score": 100,
    "grade": "A+",
    "total_guardrails": 14,
    "passed_vectors": 14,
    "warning_vectors": 0,
    "error_vectors": 0
  },
  "edge_functions": [
    {
      "name": "edge-telemetry",
      "file": "netlify/edge-functions/edge-telemetry.js",
      "runtime": "Deno (Netlify Edge)",
      "paths": ["/api/edge/telemetry", "/api/edge/geo"],
      "declared_route": "/api/edge/*",
      "emits_coop_coep": true
    }
  ],
  "serverless_functions": [
    {
      "name": "studio-api",
      "file": "netlify/functions/studio-api.js",
      "runtime": "Node.js 20 (esbuild)",
      "route_prefix": "/.netlify/functions/studio-api",
      "proxied_from": "/api/studio/*"
    }
  ],
  "configurations": {
    "redirect_rules": [
      { "from": "/api/studio/*", "to": "/.netlify/functions/studio-api/:splat", "status": 200 },
      { "from": "/hub", "to": "/", "status": 301 },
      { "from": "/hub/*", "to": "/:splat", "status": 301 },
      { "from": "/*", "to": "/index.html", "status": 200 }
    ],
    "security_headers": {
      "X-Frame-Options": "SAMEORIGIN",
      "Content-Security-Policy": "frame-ancestors 'self' https://zoth.nullai.tech https://*.nullai.tech http://127.0.0.1:* http://localhost:*",
      "X-Content-Type-Options": "nosniff",
      "Referrer-Policy": "strict-origin-when-cross-origin",
      "Permissions-Policy": "camera=(self), microphone=(self), geolocation=()",
      "Cross-Origin-Opener-Policy": "same-origin",
      "Cross-Origin-Embedder-Policy": "credentialless"
    },
    "discovery_files": [
      "/robots.txt",
      "/sitemap.xml",
      "/llms.txt",
      "/ai.txt",
      "/.well-known/mcp.json"
    ]
  },
  "endpoints": {
    "workstation": "https://zoth.nullai.tech/workstations/netlify-ax",
    "tool_alias": "https://zoth.nullai.tech/tools/netlify-ax",
    "loopback_inspector": "http://127.0.0.1:3000/api/studio/netlify-ax",
    "loopback_audit_api": "http://127.0.0.1:3000/api/studio/netlify-ax/audit",
    "loopback_spec_api": "http://127.0.0.1:3000/api/studio/netlify-spec",
    "static_manifest": "https://zoth.nullai.tech/api/netlify-ax.json",
    "expert_prompt": "https://zoth.nullai.tech/api/netlify-expert-prompt.md",
    "mcp_manifest": "https://zoth.nullai.tech/api/netlify-ax-mcp.json",
    "ontology": "https://zoth.nullai.tech/api/netlify-rules-ontology.json",
    "github_repo": "https://github.com/NullAITech/zoth-studio-v2"
  },
  "cli": {
    "open_workstation": "zoth open netlify-ax --json",
    "run_tests": "npm run test:netlify-ax",
    "safe_dry_run": "netlify build --dry"
  },
  "attribution": "Engineered by Neal Frazier Tech (@1nc0gn30) • NullAI Platform"
}
